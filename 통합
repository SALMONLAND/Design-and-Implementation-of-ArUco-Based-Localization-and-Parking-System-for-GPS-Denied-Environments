"""
ArUco 자율주차 시스템 - 통합 메인 코드
라즈베리파이 ↔ 아두이노 시리얼 통신
"""

import cv2
import cv2.aruco as aruco
import numpy as np
import serial
import json
import math
import time

# ==================== 설정 ====================

SERIAL_PORT = '/dev/ttyUSB0'  # 아두이노 포트 (확인 필요)
BAUD_RATE = 115200

FRAME_WIDTH = 640
FRAME_HEIGHT = 480
CX, CY = FRAME_WIDTH // 2, FRAME_HEIGHT // 2

ARUCO_DICT = aruco.getPredefinedDictionary(aruco.DICT_6X6_250)
ARUCO_PARAMS = aruco.DetectorParameters()
DETECTOR = aruco.ArucoDetector(ARUCO_DICT, ARUCO_PARAMS)

COLOR_RANGES = {
    'RED': [
        (np.array([0, 100, 100]), np.array([10, 255, 255])),
        (np.array([160, 100, 100]), np.array([180, 255, 255]))
    ],
    'GREEN': [(np.array([40, 100, 100]), np.array([80, 255, 255]))],
    'BLUE': [(np.array([100, 100, 100]), np.array([130, 255, 255]))],
    'WHITE': [(np.array([0, 0, 200]), np.array([180, 30, 255]))]
}

# ==================== 클래스 ====================

class ArduinoComm:
    """아두이노 시리얼 통신"""
    
    def __init__(self, port, baud):
        self.ser = None
        try:
            self.ser = serial.Serial(port, baud, timeout=0.1)
            time.sleep(2)  # 아두이노 리셋 대기
            print(f"Arduino connected: {port}")
        except Exception as e:
            print(f"Serial error: {e}")
    
    def send(self, data):
        """딕셔너리를 JSON으로 전송"""
        if self.ser and self.ser.is_open:
            try:
                msg = json.dumps(data) + '\n'
                self.ser.write(msg.encode())
            except:
                pass
    
    def receive(self):
        """아두이노로부터 JSON 수신"""
        if self.ser and self.ser.in_waiting:
            try:
                line = self.ser.readline().decode().strip()
                if line:
                    return json.loads(line)
            except:
                pass
        return None
    
    def send_command(self, cmd):
        """명령 전송 (START, STOP, EXIT)"""
        self.send({'cmd': cmd})
    
    def send_marker(self, marker_data):
        """마커 데이터 전송"""
        if marker_data:
            self.send(marker_data)
    
    def close(self):
        if self.ser:
            self.ser.close()


class VisionSystem:
    """카메라 및 마커/색상 감지"""
    
    def __init__(self, camera_id=0):
        self.cap = cv2.VideoCapture(camera_id)
        self.cap.set(cv2.CAP_PROP_FRAME_WIDTH, FRAME_WIDTH)
        self.cap.set(cv2.CAP_PROP_FRAME_HEIGHT, FRAME_HEIGHT)
        self.frame = None
    
    def read_frame(self):
        ret, self.frame = self.cap.read()
        return ret
    
    def detect_marker(self):
        if self.frame is None:
            return None
        
        gray = cv2.cvtColor(self.frame, cv2.COLOR_BGR2GRAY)
        corners, ids, _ = DETECTOR.detectMarkers(gray)
        
        if ids is None:
            return None
        
        corner = corners[0][0]
        marker_id = ids[0][0]
        
        cx = int(np.mean(corner[:, 0]))
        cy = int(np.mean(corner[:, 1]))
        
        top_mid = (corner[0] + corner[1]) / 2
        bottom_mid = (corner[2] + corner[3]) / 2
        dx = top_mid[0] - bottom_mid[0]
        dy = top_mid[1] - bottom_mid[1]
        angle = math.degrees(math.atan2(dx, -dy))
        
        aruco.drawDetectedMarkers(self.frame, corners, ids)
        
        return {
            'id': int(marker_id),
            'x': cx,
            'y': cy,
            'angle': round(angle, 2)
        }
    
    def detect_color(self, roi=None):
        if self.frame is None:
            return None
        
        if roi:
            x, y, w, h = roi
            region = self.frame[y:y+h, x:x+w]
        else:
            region = self.frame[CY-100:CY+100, CX-100:CX+100]
        
        hsv = cv2.cvtColor(region, cv2.COLOR_BGR2HSV)
        
        max_pixels, detected = 0, None
        for color, ranges in COLOR_RANGES.items():
            total = sum(cv2.countNonZero(cv2.inRange(hsv, l, u)) for l, u in ranges)
            if total > max_pixels:
                max_pixels, detected = total, color
        
        return detected if max_pixels >= 500 else None
    
    def get_marker_type(self, marker_id):
        if marker_id == 200: return 'ENTRANCE'
        if 0 <= marker_id <= 99: return 'CEILING'
        if 100 <= marker_id <= 149: return 'WALL'
        if 150 <= marker_id <= 199: return 'PARKING'
        return 'UNKNOWN'
    
    def draw_overlay(self, marker, color, status):
        if self.frame is None:
            return
        
        # 십자선
        cv2.line(self.frame, (CX-20, CY), (CX+20, CY), (255, 255, 0), 1)
        cv2.line(self.frame, (CX, CY-20), (CX, CY+20), (255, 255, 0), 1)
        
        # 정보 표시
        y = 30
        if marker:
            cv2.putText(self.frame, f"ID:{marker['id']} ({marker['x']},{marker['y']}) {marker['angle']}deg", 
                       (10, y), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)
            y += 25
        if color:
            cv2.putText(self.frame, f"Color: {color}", (10, y), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 0, 255), 2)
            y += 25
        if status:
            cv2.putText(self.frame, f"Status: {status}", (10, y), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 255), 2)
    
    def show(self):
        if self.frame is not None:
            cv2.imshow('Parking System', self.frame)
        return cv2.waitKey(1) & 0xFF
    
    def release(self):
        self.cap.release()
        cv2.destroyAllWindows()


class ParkingSystem:
    """자율주차 통합 시스템"""
    
    def __init__(self):
        self.vision = VisionSystem(camera_id=0)
        self.arduino = ArduinoComm(SERIAL_PORT, BAUD_RATE)
        self.status = "IDLE"
        self.running = True
    
    def start(self):
        """주차 시작"""
        self.arduino.send_command('START')
        print("System started - Searching mode")
    
    def stop(self):
        """정지"""
        self.arduino.send_command('STOP')
        print("System stopped")
    
    def exit_parking(self):
        """출차"""
        self.arduino.send_command('EXIT')
        print("Exiting parking")
    
    def run(self):
        """메인 루프"""
        print("=" * 50)
        print("ArUco Parking System")
        print("Commands: 's'=Start, 'e'=Exit, 'x'=Stop, 'q'=Quit")
        print("=" * 50)
        
        while self.running:
            # 프레임 읽기
            if not self.vision.read_frame():
                continue
            
            # 마커 및 색상 감지
            marker = self.vision.detect_marker()
            color = self.vision.detect_color()
            
            # 마커 데이터 아두이노로 전송
            if marker:
                self.arduino.send_marker(marker)
            
            # 아두이노 상태 수신
            response = self.arduino.receive()
            if response and 'status' in response:
                self.status = response['status']
                print(f"Arduino: {self.status}")
            
            # 화면 표시
            self.vision.draw_overlay(marker, color, self.status)
            
            # 키 입력 처리
            key = self.vision.show()
            if key == ord('q'):
                self.running = False
            elif key == ord('s'):
                self.start()
            elif key == ord('e'):
                self.exit_parking()
            elif key == ord('x'):
                self.stop()
        
        self.shutdown()
    
    def shutdown(self):
        self.stop()
        self.arduino.close()
        self.vision.release()
        print("System shutdown")


# ==================== 실행 ====================

if __name__ == "__main__":
    system = ParkingSystem()
    system.run()
```

**연결 방법:**

| 단계 | 내용 |
|------|------|
| 1. 하드웨어 | 라즈베리파이 USB ↔ 아두이노 USB 케이블 연결 |
| 2. 포트 확인 | 터미널에서 `ls /dev/ttyUSB*` 또는 `ls /dev/ttyACM*` |
| 3. 포트 수정 | `SERIAL_PORT` 값을 확인된 포트로 변경 |
| 4. 권한 설정 | `sudo chmod 666 /dev/ttyUSB0` |
| 5. 실행 | `python3 main.py` |

**통신 프로토콜:**
