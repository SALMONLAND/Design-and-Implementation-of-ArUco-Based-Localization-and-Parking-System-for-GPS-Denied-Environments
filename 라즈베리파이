"""
ArUco 기반 자율주차 시스템 - 라즈베리파이 비전 모듈
마커 ID: 천장(0-99), 벽면(100-149), 주차(150-199), 입구(200)
"""

import cv2
import cv2.aruco as aruco
import numpy as np
import math

# ArUco 설정
ARUCO_DICT = aruco.getPredefinedDictionary(aruco.DICT_6X6_250)
ARUCO_PARAMS = aruco.DetectorParameters()
DETECTOR = aruco.ArucoDetector(ARUCO_DICT, ARUCO_PARAMS)

# 카메라 설정
FRAME_WIDTH = 640
FRAME_HEIGHT = 480
CX, CY = FRAME_WIDTH // 2, FRAME_HEIGHT // 2

# 색상 범위 (HSV)
COLOR_RANGES = {
    'RED': [
        (np.array([0, 100, 100]), np.array([10, 255, 255])),
        (np.array([160, 100, 100]), np.array([180, 255, 255]))
    ],
    'GREEN': [
        (np.array([40, 100, 100]), np.array([80, 255, 255]))
    ],
    'BLUE': [
        (np.array([100, 100, 100]), np.array([130, 255, 255]))
    ],
    'WHITE': [
        (np.array([0, 0, 200]), np.array([180, 30, 255]))
    ]
}

MIN_COLOR_PIXELS = 500


class VisionSystem:
    def __init__(self, camera_id=0):
        self.cap = cv2.VideoCapture(camera_id)
        self.cap.set(cv2.CAP_PROP_FRAME_WIDTH, FRAME_WIDTH)
        self.cap.set(cv2.CAP_PROP_FRAME_HEIGHT, FRAME_HEIGHT)
        self.frame = None
    
    def read_frame(self):
        ret, self.frame = self.cap.read()
        return ret
    
    def detect_marker(self):
        """ArUco 마커 감지 → (id, x, y, angle) 또는 None"""
        if self.frame is None:
            return None
        
        gray = cv2.cvtColor(self.frame, cv2.COLOR_BGR2GRAY)
        corners, ids, _ = DETECTOR.detectMarkers(gray)
        
        if ids is None:
            return None
        
        # 첫 번째 마커 처리
        corner = corners[0][0]
        marker_id = ids[0][0]
        
        # 중심점 계산
        cx = int(np.mean(corner[:, 0]))
        cy = int(np.mean(corner[:, 1]))
        
        # 각도 계산 (마커 상단 벡터 기준)
        top_mid = (corner[0] + corner[1]) / 2
        bottom_mid = (corner[2] + corner[3]) / 2
        dx = top_mid[0] - bottom_mid[0]
        dy = top_mid[1] - bottom_mid[1]
        angle = math.degrees(math.atan2(dx, -dy))
        
        # 시각화
        aruco.drawDetectedMarkers(self.frame, corners, ids)
        cv2.circle(self.frame, (cx, cy), 5, (0, 255, 0), -1)
        
        return {
            'id': int(marker_id),
            'x': cx,
            'y': cy,
            'angle': round(angle, 2)
        }
    
    def detect_color(self, roi=None):
        """색상 감지 → 'RED', 'GREEN', 'BLUE', 'WHITE' 또는 None"""
        if self.frame is None:
            return None
        
        # ROI 설정 (기본: 중앙 200x200)
        if roi:
            x, y, w, h = roi
            region = self.frame[y:y+h, x:x+w]
        else:
            region = self.frame[CY-100:CY+100, CX-100:CX+100]
        
        hsv = cv2.cvtColor(region, cv2.COLOR_BGR2HSV)
        
        max_pixels = 0
        detected = None
        
        for color, ranges in COLOR_RANGES.items():
            total = 0
            for lower, upper in ranges:
                mask = cv2.inRange(hsv, lower, upper)
                total += cv2.countNonZero(mask)
            
            if total > max_pixels:
                max_pixels = total
                detected = color
        
        return detected if max_pixels >= MIN_COLOR_PIXELS else None
    
    def detect_parking_color(self, marker_data):
        """주차 마커 주변 색상으로 점유 상태 확인"""
        if marker_data is None:
            return None
        
        x, y = marker_data['x'], marker_data['y']
        
        # 마커 아래쪽 영역 검사 (주차 공간)
        roi_y = min(y + 30, FRAME_HEIGHT - 100)
        roi = (x - 50, roi_y, 100, 80)
        
        color = self.detect_color(roi)
        
        # RED=점유, GREEN=빈칸
        if color == 'RED':
            return 'OCCUPIED'
        elif color == 'GREEN':
            return 'EMPTY'
        return None
    
    def get_marker_type(self, marker_id):
        """마커 ID로 타입 분류"""
        if marker_id is None:
            return None
        if marker_id == 200:
            return 'ENTRANCE'
        if 0 <= marker_id <= 99:
            return 'CEILING'
        if 100 <= marker_id <= 149:
            return 'WALL'
        if 150 <= marker_id <= 199:
            return 'PARKING'
        return 'UNKNOWN'
    
    def process(self):
        """통합 처리 → 감지 결과 딕셔너리"""
        if not self.read_frame():
            return None
        
        marker = self.detect_marker()
        color = self.detect_color()
        
        result = {
            'marker': marker,
            'color': color,
            'type': None,
            'parking_status': None
        }
        
        if marker:
            result['type'] = self.get_marker_type(marker['id'])
            
            # 주차 마커일 경우 색상으로 점유 상태 추가 확인
            if result['type'] == 'PARKING':
                result['parking_status'] = self.detect_parking_color(marker)
        
        return result
    
    def draw_overlay(self, result):
        """화면에 정보 표시"""
        if self.frame is None:
            return
        
        # 중앙 십자선
        cv2.line(self.frame, (CX-20, CY), (CX+20, CY), (255, 255, 0), 1)
        cv2.line(self.frame, (CX, CY-20), (CX, CY+20), (255, 255, 0), 1)
        
        # ROI 영역
        cv2.rectangle(self.frame, (CX-100, CY-100), (CX+100, CY+100), (100, 100, 100), 1)
        
        # 정보 텍스트
        y = 30
        if result['marker']:
            m = result['marker']
            text = f"ID:{m['id']} X:{m['x']} Y:{m['y']} A:{m['angle']}"
            cv2.putText(self.frame, text, (10, y), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 0), 2)
            y += 25
        
        if result['type']:
            cv2.putText(self.frame, f"Type: {result['type']}", (10, y), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 255), 2)
            y += 25
        
        if result['color']:
            cv2.putText(self.frame, f"Color: {result['color']}", (10, y), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 0, 255), 2)
            y += 25
        
        if result['parking_status']:
            color = (0, 0, 255) if result['parking_status'] == 'OCCUPIED' else (0, 255, 0)
            cv2.putText(self.frame, f"Parking: {result['parking_status']}", (10, y), cv2.FONT_HERSHEY_SIMPLEX, 0.6, color, 2)
    
    def show(self):
        cv2.imshow('Vision', self.frame)
        return cv2.waitKey(1) & 0xFF
    
    def release(self):
        self.cap.release()
        cv2.destroyAllWindows()


# 메인 실행
if __name__ == "__main__":
    vision = VisionSystem(camera_id=0)
    print("Vision System Started (Press 'q' to quit)")
    
    while True:
        result = vision.process()
        
        if result:
            vision.draw_overlay(result)
            
            # 콘솔 출력 (디버그용)
            if result['marker']:
                print(f"Marker: {result['marker']} | Type: {result['type']} | Color: {result['color']}")
        
        key = vision.show()
        if key == ord('q'):
            break
    
    vision.release()
