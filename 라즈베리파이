import cv2
import cv2.aruco as aruco
import numpy as np

# ArUco 설정
aruco_dict = aruco.getPredefinedDictionary(aruco.DICT_6X6_250)
parameters = aruco.DetectorParameters()
detector = aruco.ArucoDetector(aruco_dict, parameters)

# 카메라 설정 (라즈베리파이)
cap = cv2.VideoCapture(0)
cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)


def detect_color(frame, roi=None):
    """
    색상 감지 함수 (흰색, 파란색, 빨간색)
    roi: 관심영역 (x, y, w, h) - None이면 전체 프레임
    반환: 'WHITE', 'BLUE', 'RED', None
    """
    if roi is not None:
        x, y, w, h = roi
        region = frame[y:y+h, x:x+w]
    else:
        # 프레임 중앙 영역 사용
        h, w = frame.shape[:2]
        cx, cy = w // 2, h // 2
        size = 100
        region = frame[cy-size:cy+size, cx-size:cx+size]
    
    hsv = cv2.cvtColor(region, cv2.COLOR_BGR2HSV)
    
    # 색상 범위 정의 (HSV)
    color_ranges = {
        'RED': [
            (np.array([0, 100, 100]), np.array([10, 255, 255])),      # 빨간색 하단
            (np.array([160, 100, 100]), np.array([180, 255, 255]))    # 빨간색 상단
        ],
        'BLUE': [
            (np.array([100, 100, 100]), np.array([130, 255, 255]))
        ],
        'WHITE': [
            (np.array([0, 0, 200]), np.array([180, 30, 255]))
        ]
    }
    
    max_pixels = 0
    detected_color = None
    
    for color_name, ranges in color_ranges.items():
        total_pixels = 0
        for lower, upper in ranges:
            mask = cv2.inRange(hsv, lower, upper)
            total_pixels += cv2.countNonZero(mask)
        
        if total_pixels > max_pixels:
            max_pixels = total_pixels
            detected_color = color_name
    
    # 최소 픽셀 임계값 (노이즈 방지)
    min_threshold = 500
    if max_pixels < min_threshold:
        return None
    
    return detected_color


def detect_aruco_marker(frame):
    """
    ArUco 마커 감지 함수
    반환: 마커 ID 리스트 또는 None
    """
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    corners, ids, _ = detector.detectMarkers(gray)
    
    if ids is not None:
        aruco.drawDetectedMarkers(frame, corners, ids)
        return [id[0] for id in ids]
    
    return None


def detect(frame, mode='both'):
    """
    통합 감지 함수
    mode: 'aruco', 'color', 'both'
    반환: {'aruco_ids': [...], 'color': 'RED/BLUE/WHITE'}
    """
    result = {
        'aruco_ids': None,
        'color': None
    }
    
    if mode in ['aruco', 'both']:
        result['aruco_ids'] = detect_aruco_marker(frame)
    
    if mode in ['color', 'both']:
        result['color'] = detect_color(frame)
    
    return result


def get_detection():
    """
    단일 감지 수행 후 결과 반환
    다른 모듈에서 호출용
    """
    ret, frame = cap.read()
    if not ret:
        return None
    
    return detect(frame, mode='both')


# 메인 루프 (테스트/디버깅용)
if __name__ == "__main__":
    print("ArUco & Color Detection Started")
    print("Press 'q' to quit")
    
    while True:
        ret, frame = cap.read()
        if not ret:
            print("Camera read failed")
            break
        
        # 감지 수행
        result = detect(frame, mode='both')
        
        # 결과 표시
        info_text = []
        if result['aruco_ids']:
            info_text.append(f"ID: {result['aruco_ids']}")
        if result['color']:
            info_text.append(f"Color: {result['color']}")
        
        # 화면에 정보 표시
        y_pos = 30
        for text in info_text:
            cv2.putText(frame, text, (10, y_pos), 
                       cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)
            y_pos += 30
        
        # 중앙 ROI 표시 (색상 감지 영역)
        h, w = frame.shape[:2]
        cx, cy = w // 2, h // 2
        cv2.rectangle(frame, (cx-100, cy-100), (cx+100, cy+100), (255, 255, 0), 2)
        
        cv2.imshow('Detection', frame)
        
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break
    
    cap.release()
    cv2.destroyAllWindows()
