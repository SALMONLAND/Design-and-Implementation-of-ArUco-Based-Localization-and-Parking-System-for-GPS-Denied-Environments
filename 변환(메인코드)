"""
ArUco 기반 실내 자율주차 시스템
라즈베리파이 단독 구동 (카메라 + GPIO 모터)

설계 문서: Design_note_ver1.0
마커 ID 체계:
  - 천장  (0~99)   : 경로 추종
  - 벽면  (100~149): 방향 전환 (100~124 좌회전, 125~149 우회전)
  - 주차  (150~199): 홀수=빈칸, 짝수=점유
  - 입구  (200)    : 진입/퇴장 지점

상태 머신: IDLE → SEARCHING → PARKING → PARKED → EXITING
"""

import cv2
import cv2.aruco as aruco
import numpy as np
import lgpio
import math
import time
import signal
import sys


# ═══════════════════════════════════════════════════
#  1. 상수 정의
# ═══════════════════════════════════════════════════

# --- GPIO 핀 (4채널 탱크 구동) ---
GPIOCHIP   = 4
LEFT_FWD_A, LEFT_REV_A   = 17, 27   # 좌측 전방 모터
LEFT_FWD_B, LEFT_REV_B   = 22, 23   # 좌측 후방 모터
RIGHT_FWD_A, RIGHT_REV_A = 24, 25   # 우측 전방 모터
RIGHT_FWD_B, RIGHT_REV_B =  5,  6   # 우측 후방 모터
ALL_PINS = [
    LEFT_FWD_A, LEFT_REV_A, LEFT_FWD_B, LEFT_REV_B,
    RIGHT_FWD_A, RIGHT_REV_A, RIGHT_FWD_B, RIGHT_REV_B,
]

# --- 카메라 ---
CAMERA_ID    = 0
FRAME_WIDTH  = 640
FRAME_HEIGHT = 480
CX = FRAME_WIDTH  // 2   # 320
CY = FRAME_HEIGHT // 2   # 240

# --- ArUco ---
ARUCO_DICT   = aruco.getPredefinedDictionary(aruco.DICT_6X6_250)
ARUCO_PARAMS = aruco.DetectorParameters()
DETECTOR     = aruco.ArucoDetector(ARUCO_DICT, ARUCO_PARAMS)

# --- 마커 ID 범위 ---
CEILING_MIN, CEILING_MAX =   0,  99
WALL_MIN,    WALL_MAX    = 100, 149
WALL_LEFT_MAX            = 124      # 100~124 좌회전
PARKING_MIN, PARKING_MAX = 150, 199
ENTRANCE_ID              = 200

# --- PID 이득 (설계문서 기준) ---
PID_X     = {'kp': 1.2, 'ki': 0.1, 'kd': 0.5}
PID_Y     = {'kp': 1.0, 'ki': 0.08, 'kd': 0.4}
PID_ANGLE = {'kp': 3.0, 'ki': 0.2, 'kd': 1.0}

# --- 허용 오차 ---
TOLERANCE_X     = 20    # px  (±5cm 상당, 실차 조정)
TOLERANCE_Y     = 20    # px
TOLERANCE_ANGLE = 3.0   # deg

# --- 타이밍 ---
MARKER_TIMEOUT  = 0.5   # 마커 미감지 타임아웃 (초)
TURN_DURATION   = 0.8   # 제자리 회전 시간 (초, 실차 조정)
EXIT_REVERSE_T  = 1.5   # 출차 후진 시간 (초)

# --- 색상 범위 (HSV) ---
COLOR_RANGES = {
    'RED': [
        (np.array([0,   100, 100]), np.array([10,  255, 255])),
        (np.array([160, 100, 100]), np.array([180, 255, 255])),
    ],
    'GREEN': [(np.array([40,  100, 100]), np.array([80,  255, 255]))],
    'BLUE':  [(np.array([100, 100, 100]), np.array([130, 255, 255]))],
    'WHITE': [(np.array([0,   0,   200]), np.array([180, 30,  255]))],
}
MIN_COLOR_PIXELS = 500


# ═══════════════════════════════════════════════════
#  2. 마커 분류 유틸
# ═══════════════════════════════════════════════════

def classify_marker(marker_id):
    """마커 ID → 타입 문자열"""
    if marker_id == ENTRANCE_ID:
        return 'ENTRANCE'
    if CEILING_MIN <= marker_id <= CEILING_MAX:
        return 'CEILING'
    if WALL_MIN <= marker_id <= WALL_MAX:
        return 'WALL_LEFT' if marker_id <= WALL_LEFT_MAX else 'WALL_RIGHT'
    if PARKING_MIN <= marker_id <= PARKING_MAX:
        return 'PARKING_EMPTY' if marker_id % 2 == 1 else 'PARKING_OCCUPIED'
    return 'UNKNOWN'


# ═══════════════════════════════════════════════════
#  3. PID 컨트롤러
# ═══════════════════════════════════════════════════

class PIDController:
    """단일 축 PID"""

    def __init__(self, kp, ki, kd, limit=1.0):
        self.kp = kp
        self.ki = ki
        self.kd = kd
        self.limit = limit
        self.prev_error = 0.0
        self.integral   = 0.0

    def update(self, error, dt=0.033):
        self.integral += error * dt
        derivative = (error - self.prev_error) / dt if dt > 0 else 0.0
        self.prev_error = error
        output = self.kp * error + self.ki * self.integral + self.kd * derivative
        return max(-self.limit, min(self.limit, output))

    def reset(self):
        self.prev_error = 0.0
        self.integral   = 0.0


# ═══════════════════════════════════════════════════
#  4. 모터 드라이버
# ═══════════════════════════════════════════════════

class MotorDriver:
    """lgpio 기반 4륜 탱크 구동 (ON/OFF)"""

    def __init__(self):
        self.h = lgpio.gpiochip_open(GPIOCHIP)
        for pin in ALL_PINS:
            lgpio.gpio_claim_output(self.h, pin, 0)

    def _left(self, d):
        """좌측 모터: 1=전진, -1=후진, 0=정지"""
        lgpio.gpio_write(self.h, LEFT_FWD_A,  max( d, 0))
        lgpio.gpio_write(self.h, LEFT_REV_A,  max(-d, 0))
        lgpio.gpio_write(self.h, LEFT_FWD_B,  max( d, 0))
        lgpio.gpio_write(self.h, LEFT_REV_B,  max(-d, 0))

    def _right(self, d):
        """우측 모터: 1=전진, -1=후진, 0=정지"""
        lgpio.gpio_write(self.h, RIGHT_FWD_A, max( d, 0))
        lgpio.gpio_write(self.h, RIGHT_REV_A, max(-d, 0))
        lgpio.gpio_write(self.h, RIGHT_FWD_B, max( d, 0))
        lgpio.gpio_write(self.h, RIGHT_REV_B, max(-d, 0))

    def forward(self):
        self._left(1);  self._right(1)

    def backward(self):
        self._left(-1); self._right(-1)

    def turn_left(self):
        self._left(-1); self._right(1)

    def turn_right(self):
        self._left(1);  self._right(-1)

    def stop(self):
        self._left(0);  self._right(0)

    def steer(self, left_dir, right_dir):
        """좌/우 개별 지정 (-1, 0, 1)"""
        self._left(left_dir)
        self._right(right_dir)

    def close(self):
        self.stop()
        lgpio.gpiochip_close(self.h)


# ═══════════════════════════════════════════════════
#  5. 비전 시스템
# ═══════════════════════════════════════════════════

class VisionSystem:
    """카메라 영상 → 마커/색상 감지"""

    def __init__(self):
        self.cap = cv2.VideoCapture(CAMERA_ID)
        self.cap.set(cv2.CAP_PROP_FRAME_WIDTH,  FRAME_WIDTH)
        self.cap.set(cv2.CAP_PROP_FRAME_HEIGHT, FRAME_HEIGHT)
        self.frame = None

    def read(self):
        ret, self.frame = self.cap.read()
        return ret

    def detect_marker(self):
        """첫 번째 ArUco 마커 → dict{id, x, y, angle, type} 또는 None"""
        if self.frame is None:
            return None

        gray = cv2.cvtColor(self.frame, cv2.COLOR_BGR2GRAY)
        corners, ids, _ = DETECTOR.detectMarkers(gray)
        if ids is None:
            return None

        corner = corners[0][0]
        mid_top    = (corner[0] + corner[1]) / 2
        mid_bottom = (corner[2] + corner[3]) / 2
        dx = mid_top[0] - mid_bottom[0]
        dy = mid_top[1] - mid_bottom[1]

        marker = {
            'id':    int(ids[0][0]),
            'x':     int(np.mean(corner[:, 0])),
            'y':     int(np.mean(corner[:, 1])),
            'angle': round(math.degrees(math.atan2(dx, -dy)), 2),
        }
        marker['type'] = classify_marker(marker['id'])

        aruco.drawDetectedMarkers(self.frame, corners, ids)
        return marker

    def detect_color(self, roi=None):
        """지배적 색상 → 문자열 또는 None"""
        if self.frame is None:
            return None
        if roi:
            x, y, w, h = roi
            region = self.frame[y:y+h, x:x+w]
        else:
            region = self.frame[CY-100:CY+100, CX-100:CX+100]

        hsv = cv2.cvtColor(region, cv2.COLOR_BGR2HSV)
        best_count, best_color = 0, None
        for color, ranges in COLOR_RANGES.items():
            total = sum(cv2.countNonZero(cv2.inRange(hsv, lo, hi)) for lo, hi in ranges)
            if total > best_count:
                best_count, best_color = total, color
        return best_color if best_count >= MIN_COLOR_PIXELS else None

    def draw_hud(self, marker, color, status):
        """화면 오버레이"""
        if self.frame is None:
            return
        cv2.line(self.frame, (CX-20, CY), (CX+20, CY), (255, 255, 0), 1)
        cv2.line(self.frame, (CX, CY-20), (CX, CY+20), (255, 255, 0), 1)

        y = 30
        cv2.putText(self.frame, f"[{status}]", (10, y),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 255), 2)
        y += 30
        if marker:
            txt = (f"ID:{marker['id']}({marker['type']})  "
                   f"pos=({marker['x']},{marker['y']})  "
                   f"angle={marker['angle']}")
            cv2.putText(self.frame, txt, (10, y),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.45, (0, 255, 0), 1)
            y += 22
        if color:
            cv2.putText(self.frame, f"Color: {color}", (10, y),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 0, 255), 1)

    def show(self):
        if self.frame is not None:
            cv2.imshow('ArUco Parking', self.frame)
        return cv2.waitKey(1) & 0xFF

    def release(self):
        self.cap.release()
        cv2.destroyAllWindows()


# ═══════════════════════════════════════════════════
#  6. 메인 시스템 (상태 머신)
# ═══════════════════════════════════════════════════

class ParkingSystem:
    """
    상태 흐름:
      IDLE ─(s)─▶ SEARCHING ─(빈 주차)─▶ PARKING
                                             │
      EXITING ◀─(e)── PARKED ◀─(정렬 완료)──┘
         │
         └─(입구 마커)─▶ IDLE
    """

    def __init__(self):
        self.vision = VisionSystem()
        self.motor  = MotorDriver()

        self.pid_x = PIDController(**PID_X)
        self.pid_y = PIDController(**PID_Y)
        self.pid_a = PIDController(**PID_ANGLE)

        self.state = 'IDLE'
        self.last_marker_time = time.time()
        self.running = True

        signal.signal(signal.SIGINT, lambda *_: setattr(self, 'running', False))

    # ────────── 상태별 핸들러 ──────────

    def _on_idle(self, marker):
        self.motor.stop()

    def _on_searching(self, marker):
        """천장 마커 추종 · 벽면 회전 · 빈 주차 감지"""
        if marker is None:
            if time.time() - self.last_marker_time < MARKER_TIMEOUT:
                self.motor.forward()   # 저속 전진 유지
            else:
                self.motor.stop()
            return

        t = marker['type']

        if t == 'CEILING':
            error_x = marker['x'] - CX
            if abs(error_x) < TOLERANCE_X:
                self.motor.forward()
            elif error_x > 0:
                self.motor.steer(1, 0)  # 우측 치우침 → 좌전진만
            else:
                self.motor.steer(0, 1)

        elif t == 'WALL_LEFT':
            self._do_turn('LEFT')

        elif t == 'WALL_RIGHT':
            self._do_turn('RIGHT')

        elif t == 'PARKING_EMPTY':
            print(f">>> 빈 주차 공간 발견: ID {marker['id']}")
            self._reset_pid()
            self.state = 'PARKING'

        elif t == 'PARKING_OCCUPIED':
            self.motor.forward()       # 점유 → 통과

        elif t == 'ENTRANCE':
            self.motor.forward()       # 입구 통과

    def _on_parking(self, marker):
        """PID 정밀 주차 (우선순위: 각도 → Y → X)"""
        if marker is None:
            if time.time() - self.last_marker_time > MARKER_TIMEOUT:
                self.motor.stop()
            return

        ex = marker['x'] - CX
        ey = marker['y'] - CY
        ea = marker['angle']

        # 수렴 판정
        if abs(ex) < TOLERANCE_X and abs(ey) < TOLERANCE_Y and abs(ea) < TOLERANCE_ANGLE:
            self.motor.stop()
            self.state = 'PARKED'
            print(">>> 주차 완료!")
            return

        # 우선순위 1: 각도
        if abs(ea) > TOLERANCE_ANGLE:
            out = self.pid_a.update(ea)
            self.motor.turn_left() if out > 0 else self.motor.turn_right()

        # 우선순위 2: Y축 (전후)
        elif abs(ey) > TOLERANCE_Y:
            out = self.pid_y.update(ey)
            self.motor.backward() if out > 0 else self.motor.forward()

        # 우선순위 3: X축 (좌우)
        else:
            out = self.pid_x.update(ex)
            self.motor.turn_right() if out > 0 else self.motor.turn_left()

    def _on_parked(self, marker):
        self.motor.stop()

    def _on_exiting(self, marker):
        """천장 마커 추종 → 입구 감지 시 IDLE"""
        if marker is None:
            if time.time() - self.last_marker_time < MARKER_TIMEOUT:
                self.motor.forward()
            else:
                self.motor.stop()
            return

        t = marker['type']

        if t == 'ENTRANCE':
            self.motor.stop()
            self.state = 'IDLE'
            print(">>> 출차 완료!")

        elif t == 'CEILING':
            error_x = marker['x'] - CX
            if abs(error_x) < TOLERANCE_X:
                self.motor.forward()
            elif error_x > 0:
                self.motor.steer(1, 0)
            else:
                self.motor.steer(0, 1)

        elif t == 'WALL_LEFT':
            self._do_turn('LEFT')

        elif t == 'WALL_RIGHT':
            self._do_turn('RIGHT')

        else:
            self.motor.forward()

    # ────────── 유틸 ──────────

    _HANDLERS = {
        'IDLE':      '_on_idle',
        'SEARCHING': '_on_searching',
        'PARKING':   '_on_parking',
        'PARKED':    '_on_parked',
        'EXITING':   '_on_exiting',
    }

    def _do_turn(self, direction):
        """블로킹 제자리 회전"""
        print(f">>> 회전: {direction}")
        (self.motor.turn_left if direction == 'LEFT' else self.motor.turn_right)()
        time.sleep(TURN_DURATION)
        self.motor.stop()

    def _reset_pid(self):
        self.pid_x.reset()
        self.pid_y.reset()
        self.pid_a.reset()

    def _begin_exit(self):
        """출차: 후진 → EXITING 전환"""
        print(">>> 출차 시작 (후진)")
        self.motor.backward()
        time.sleep(EXIT_REVERSE_T)
        self.motor.stop()
        self.state = 'EXITING'

    # ────────── 키 입력 ──────────

    def _handle_key(self, key):
        if key == ord('q'):
            self.running = False
        elif key == ord('s') and self.state == 'IDLE':
            self.state = 'SEARCHING'
            print(">>> 탐색 시작")
        elif key == ord('e') and self.state == 'PARKED':
            self._begin_exit()
        elif key == ord('x'):
            self.motor.stop()
            self.state = 'IDLE'
            print(">>> 긴급 정지")

    # ────────── 메인 루프 ──────────

    def run(self):
        print("=" * 55)
        print("  ArUco 자율주차 시스템  (Raspberry Pi standalone)")
        print("  s=탐색시작  e=출차  x=긴급정지  q=종료")
        print("=" * 55)

        while self.running:
            if not self.vision.read():
                continue

            marker = self.vision.detect_marker()
            color  = self.vision.detect_color()

            if marker:
                self.last_marker_time = time.time()

            # 상태별 핸들러 디스패치
            getattr(self, self._HANDLERS[self.state])(marker)

            self.vision.draw_hud(marker, color, self.state)
            self._handle_key(self.vision.show())

        self.shutdown()

    def shutdown(self):
        self.motor.close()
        self.vision.release()
        print(">>> 시스템 종료")


# ═══════════════════════════════════════════════════
#  7. 실행
# ═══════════════════════════════════════════════════

if __name__ == "__main__":
    ParkingSystem().run()
