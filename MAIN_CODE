/*
 * ArUco 기반 자율주차 시스템 v1.0
 * 4륜 구동 
 * 
 * 마커 ID: 천장(0-99), 벽면(100-149), 주차(150-199), 입구(200)
 * 주차 공간: 홀수=빈칸, 짝수=점유
 */

#include <ArduinoJson.h>
#include <PID_v1.h>

// 모터 핀 (4륜: 좌측 전/후, 우측 전/후)
#define LF_FWD 4   // 왼쪽 앞
#define LF_BWD 5
#define LB_FWD 6   // 왼쪽 뒤
#define LB_BWD 7
#define RF_FWD 8   // 오른쪽 앞
#define RF_BWD 9
#define RB_FWD 10  // 오른쪽 뒤
#define RB_BWD 11

// 시스템 상태
enum State { IDLE, SEARCHING, PARKING, PARKED, EXITING };
State state = IDLE;

// 카메라 중심
const int CX = 320, CY = 240;

// 허용 오차
const int TOL_X = 15, TOL_Y = 15;
const float TOL_ANGLE = 3.0;

// 속도 설정
const int SPD_SEARCH = 120, SPD_PARK = 100, SPD_EXIT = 100, SPD_TURN = 140;

// 마커 데이터
int mID = -1, mX = CX, mY = CY;
float mAngle = 0;
unsigned long lastRx = 0;

// PID 변수
double setX = CX, inX = CX, outX = 0;
double setY = CY, inY = CY, outY = 0;
double setA = 0, inA = 0, outA = 0;

PID pidX(&inX, &outX, &setX, 1.2, 0.1, 0.5, DIRECT);
PID pidY(&inY, &outY, &setY, 1.0, 0.08, 0.4, DIRECT);
PID pidA(&inA, &outA, &setA, 3.0, 0.2, 1.0, DIRECT);

void setup() {
  Serial.begin(115200);
  
  int pins[] = {LF_FWD, LF_BWD, LB_FWD, LB_BWD, RF_FWD, RF_BWD, RB_FWD, RB_BWD};
  for (int p : pins) pinMode(p, OUTPUT);
  
  pidX.SetMode(AUTOMATIC);
  pidX.SetOutputLimits(-SPD_PARK, SPD_PARK);
  pidY.SetMode(AUTOMATIC);
  pidY.SetOutputLimits(-SPD_PARK, SPD_PARK);
  pidA.SetMode(AUTOMATIC);
  pidA.SetOutputLimits(-SPD_PARK, SPD_PARK);
  
  stop();
  Serial.println("{\"status\":\"READY\"}");
}

void loop() {
  processSerial();
  
  if (millis() - lastRx > 500) {
    if (state == SEARCHING || state == EXITING) forward(80);
    else if (state == PARKING) stop();
  }
  delay(10);
}

// ==================== 시리얼 처리 ====================

void processSerial() {
  if (!Serial.available()) return;
  
  String json = Serial.readStringUntil('\n');
  json.trim();
  if (json.length() == 0) return;
  
  StaticJsonDocument<256> doc;
  if (deserializeJson(doc, json)) return;
  
  lastRx = millis();
  
  if (doc.containsKey("cmd")) {
    const char* cmd = doc["cmd"];
    if (strcmp(cmd, "START") == 0) { state = SEARCHING; sendStatus("SEARCHING"); }
    else if (strcmp(cmd, "EXIT") == 0 && state == PARKED) { state = EXITING; sendStatus("EXITING"); }
    else if (strcmp(cmd, "STOP") == 0) { state = IDLE; stop(); sendStatus("STOPPED"); }
    return;
  }
  
  if (doc.containsKey("id")) {
    mID = doc["id"];
    mX = doc["x"] | CX;
    mY = doc["y"] | CY;
    mAngle = doc["angle"] | 0.0;
    updateState();
  }
}

// ==================== 상태 머신 ====================

void updateState() {
  switch (state) {
    case IDLE: stop(); break;
    case SEARCHING: handleSearch(); break;
    case PARKING: handleParking(); break;
    case PARKED: stop(); break;
    case EXITING: handleExit(); break;
  }
}

void handleSearch() {
  if (mID >= 0 && mID <= 99) followCeiling();
  else if (mID >= 100 && mID <= 149) turnAtWall();
  else if (mID >= 150 && mID <= 199) checkParkingSpot();
  else if (mID == 200) followCeiling();
}

void handleParking() {
  if (mID < 150 || mID > 199) return;
  
  inX = mX; inY = mY; inA = mAngle;
  int errX = abs(mX - CX), errY = abs(mY - CY);
  float errA = abs(mAngle);
  
  if (errX < TOL_X && errY < TOL_Y && errA < TOL_ANGLE) {
    stop();
    state = PARKED;
    sendStatus("PARKING_COMPLETE");
    return;
  }
  
  pidX.Compute(); pidY.Compute(); pidA.Compute();
  
  int left = 0, right = 0;
  
  if (errA > TOL_ANGLE) {
    left = -(int)outA; right = (int)outA;  // 제자리 회전
  } else if (errY > TOL_Y) {
    left = right = (int)outY;
  } else {
    left = SPD_PARK/2 - (int)outX;
    right = SPD_PARK/2 + (int)outX;
  }
  
  drive(left, right);
  sendDebug(errX, errY, errA);
}

void handleExit() {
  if (mID == 200) {
    stop();
    state = IDLE;
    sendStatus("EXIT_COMPLETE");
  } else if (mID >= 0 && mID <= 99) {
    followCeiling();
  } else if (mID >= 100 && mID <= 149) {
    turnAtWall();
  } else if (mID >= 150 && mID <= 199) {
    backward(SPD_EXIT);
    delay(300);
  }
}

// ==================== 주행 동작 ====================

void followCeiling() {
  int err = mX - CX;
  int corr = err / 4;
  drive(SPD_SEARCH + corr, SPD_SEARCH - corr);
}

void turnAtWall() {
  stop(); delay(100);
  
  if (mID < 125) spinLeft(SPD_TURN);
  else spinRight(SPD_TURN);
  delay(450);  // 90도 회전 (튜닝 필요)
  
  stop(); delay(100);
}

void checkParkingSpot() {
  if (mID % 2 == 0) {
    forward(SPD_SEARCH);  // 점유 → 통과
  } else {
    state = PARKING;      // 빈칸 → 주차 시작
    sendStatus("PARKING_STARTED");
  }
}

// ==================== 모터 제어 ====================

void drive(int left, int right) {
  left = constrain(left, -255, 255);
  right = constrain(right, -255, 255);
  
  // 왼쪽 모터 (앞+뒤 동일)
  if (left >= 0) {
    analogWrite(LF_FWD, left); analogWrite(LF_BWD, 0);
    analogWrite(LB_FWD, left); analogWrite(LB_BWD, 0);
  } else {
    analogWrite(LF_FWD, 0); analogWrite(LF_BWD, -left);
    analogWrite(LB_FWD, 0); analogWrite(LB_BWD, -left);
  }
  
  // 오른쪽 모터 (앞+뒤 동일)
  if (right >= 0) {
    analogWrite(RF_FWD, right); analogWrite(RF_BWD, 0);
    analogWrite(RB_FWD, right); analogWrite(RB_BWD, 0);
  } else {
    analogWrite(RF_FWD, 0); analogWrite(RF_BWD, -right);
    analogWrite(RB_FWD, 0); analogWrite(RB_BWD, -right);
  }
}

void forward(int spd)  { drive(spd, spd); } // 직진
void backward(int spd) { drive(-spd, -spd); } // 후진
void spinLeft(int spd) { drive(-spd, spd); }   // 제자리 좌회전
void spinRight(int spd){ drive(spd, -spd); }   // 제자리 우회전
void stop() { drive(0, 0); }

// ==================== 통신 ====================

void sendStatus(const char* s) {
  Serial.print("{\"status\":\""); Serial.print(s); Serial.println("\"}");
}
// 디버
void sendDebug(int ex, int ey, float ea) {
  Serial.print("{\"eX\":"); Serial.print(ex);
  Serial.print(",\"eY\":"); Serial.print(ey);
  Serial.print(",\"eA\":"); Serial.print(ea);
  Serial.println("}");
}
