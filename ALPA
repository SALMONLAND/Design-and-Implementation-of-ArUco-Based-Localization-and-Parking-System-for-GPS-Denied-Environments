import lgpio, time

GPIOCHIP = 4
A1,A2 = 17,27
B1,B2 = 22,23
C1,C2 = 24,25
D1,D2 =  5, 6

PINS = [A1,A2,B1,B2,C1,C2,D1,D2]

h = lgpio.gpiochip_open(GPIOCHIP)

# 모든 핀을 LOW로 설정 
for p in PINS:
    lgpio.gpio_claim_output(h, p, 0)  # 이미 0으로 초기화됨
    lgpio.gpio_write(h, p, 0)  # 한 번 더 확실하게!

time.sleep(0.1)  # 안정화 시간

def left(d):
    lgpio.gpio_write(h, A1, max(d,0)); lgpio.gpio_write(h, A2, max(-d,0))
    lgpio.gpio_write(h, B1, max(d,0)); lgpio.gpio_write(h, B2, max(-d,0))

def right(d):
    lgpio.gpio_write(h, C1, max(d,0)); lgpio.gpio_write(h, C2, max(-d,0))
    lgpio.gpio_write(h, D1, max(d,0)); lgpio.gpio_write(h, D2, max(-d,0))

# 부팅 시 자동으로 모터 정지 상태로 만들기
left(0); right(0)

try:
    left(1);  right(1);  time.sleep(2)
    left(0);  right(0);  time.sleep(1)
    left(-1); right(-1); time.sleep(2)
    left(1);  right(-1); time.sleep(1)
    left(-1); right(1);  time.sleep(1)
except KeyboardInterrupt:
    pass
finally:
    for p in PINS: lgpio.gpio_write(h, p, 0)
    lgpio.gpiochip_close(h)
